{
  "schemaVersion": 1,
  "id": "axiom-portals",
  "version": "${version}",
  "name": "Axiom-Portals Compatibility",
  "description": "Seamless compatibility between Immersive Portals and Axiom mods",
  "authors": [
    "AxiomGames"
  ],
  "contact": {
    "website": "https://github.com/mrcablers/axiom-portals",
    "sources": "https://github.com/mrcablers/axiom-portals"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.axiomportals.AxiomPortalsMain"
    ],
    "client": [
      "com.axiomportals.client.AxiomPortalsClient"
    ]
  },
  "mixins": [
    "axiom_portals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "immersive-portals": "*",
    "axiom": "*"
  },
  "breaks": {
  },
  "conflicts": {
  },
  "custom": {
    "modmenu": {
      "parent": {
        "immersive-portals": "immersive-portals handles portals",
        "axiom": "axiom handles world editing"
      },
      "links": {
        "source": "https://github.com/mrcablers/axiom-portals",
        "issues": "https://github.com/mrcablers/axiom-portals/issues"
      },
      "badges": [
        "client",
        "server",
        "library"
      ]
    },
    "axiom-portals": {
      "compatible_with": [
        "immersive-portals",
        "axiom"
      ],
      "resolves_conflict": true,
      "compatibility_level": "full"
    }
  }
}
